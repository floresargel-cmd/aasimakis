all: sub-idc-all  FORCE
clean: sub-idc-clean  FORCE
distclean: sub-idc-distclean  FORCE
	-$(DEL_FILE) Makefile
install_subtargets: sub-idc-install_subtargets FORCE
uninstall_subtargets: sub-idc-uninstall_subtargets FORCE

sub-idc-debug:
	@if not exist idc\ mkdir idc\ & if not exist idc\ exit 1
	@set MAKEFLAGS=$(MAKEFLAGS)
	cd idc\ && ( if not exist Makefile $(QMAKE) R:\development\libs\qt\qt.5.7.0.static.x32\qtactiveqt\src\tools\idc\idc.pro -o Makefile ) && $(MAKE) -f Makefile debug
debug: sub-idc-debug

