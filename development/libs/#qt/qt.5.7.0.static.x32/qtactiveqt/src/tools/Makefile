	@set MAKEFLAGS=$(MAKEFLAGS)
	cd idc\ && ( if not exist Makefile $(QMAKE) R:\development\libs\qt\qt.5.7.0.static.x32\qtactiveqt\src\tools\idc\idc.pro -o Makefile ) && $(MAKE) -f Makefile release
