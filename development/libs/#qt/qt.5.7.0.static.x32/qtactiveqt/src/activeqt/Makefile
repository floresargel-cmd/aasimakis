sub-axshared-prx-debug_ordered:
	@set MAKEFLAGS=$(MAKEFLAGS)
	( if not exist Makefile.axshared $(QMAKE) R:\development\libs\qt\qt.5.7.0.static.x32\qtactiveqt\src\activeqt\axshared.prx -o Makefile.axshared ) && $(MAKE) -f Makefile.axshared debug
sub-container-debug_ordered: sub-axshared-prx-debug_ordered 
	@if not exist container\ mkdir container\ & if not exist container\ exit 1
	@set MAKEFLAGS=$(MAKEFLAGS)
	cd container\ && ( if not exist Makefile $(QMAKE) R:\development\libs\qt\qt.5.7.0.static.x32\qtactiveqt\src\activeqt\container\container.pro -o Makefile ) && $(MAKE) -f Makefile debug
