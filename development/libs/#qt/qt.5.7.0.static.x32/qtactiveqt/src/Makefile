sub-activeqt-debug_ordered:
	@if not exist activeqt\ mkdir activeqt\ & if not exist activeqt\ exit 1
	@set MAKEFLAGS=$(MAKEFLAGS)
	cd activeqt\ && ( if not exist Makefile $(QMAKE) R:\development\libs\qt\qt.5.7.0.static.x32\qtactiveqt\src\activeqt\activeqt.pro -o Makefile ) && $(MAKE) -f Makefile debug
sub-tools-debug_ordered: sub-activeqt-debug_ordered 
	@if not exist tools\ mkdir tools\ & if not exist tools\ exit 1
	@set MAKEFLAGS=$(MAKEFLAGS)
	cd tools\ && ( if not exist Makefile $(QMAKE) R:\development\libs\qt\qt.5.7.0.static.x32\qtactiveqt\src\tools\tools.pro -o Makefile ) && $(MAKE) -f Makefile debug
