	cd wmf\ && ( if not exist Makefile $(QMAKE) R:\development\libs\qt\qt.5.7.0.static.x32\qtmultimedia\src\plugins\wmf\wmf.pro -o Makefile ) && $(MAKE) -f Makefile generate_docs
generate_docs: sub-m3u-generate_docs sub-audiocapture-generate_docs sub-windowsaudio-generate_docs sub-directshow-generate_docs sub-wmf-generate_docs

