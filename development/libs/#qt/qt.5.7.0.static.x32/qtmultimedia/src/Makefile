sub-multimedia-debug:
	@if not exist multimedia\ mkdir multimedia\ & if not exist multimedia\ exit 1
	@set MAKEFLAGS=$(MAKEFLAGS)
	cd multimedia\ && ( if not exist Makefile $(QMAKE) R:\development\libs\qt\qt.5.7.0.static.x32\qtmultimedia\src\multimedia\multimedia.pro -o Makefile ) && $(MAKE) -f Makefile debug
