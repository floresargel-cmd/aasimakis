	@set MAKEFLAGS=$(MAKEFLAGS)
	cd multimediawidgets\ && ( if not exist Makefile $(QMAKE) R:\development\libs\qt\qt.5.7.0.static.x32\qtmultimedia\src\multimediawidgets\multimediawidgets.pro -o Makefile ) && $(MAKE) -f Makefile debug
