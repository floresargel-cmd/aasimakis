qmake: FORCE
	@$(QMAKE) -o Makefile src.pro

qmake_all: sub-serialport-qmake_all FORCE

make_first: sub-serialport-make_first  FORCE
all: sub-serialport-all  FORCE
clean: sub-serialport-clean  FORCE
distclean: sub-serialport-distclean  FORCE
	-$(DEL_FILE) Makefile
install_subtargets: sub-serialport-install_subtargets FORCE
uninstall_subtargets: sub-serialport-uninstall_subtargets FORCE

sub-serialport-debug:
	@if not exist serialport\ mkdir serialport\ & if not exist serialport\ exit 1
	@set MAKEFLAGS=$(MAKEFLAGS)
	cd serialport\ && ( if not exist Makefile $(QMAKE) R:\development\libs\qt\qt.5.7.0.static.x32\qtserialport\src\serialport\serialport.pro -o Makefile ) && $(MAKE) -f Makefile debug
debug: sub-serialport-debug

sub-serialport-release:
	@if not exist serialport\ mkdir serialport\ & if not exist serialport\ exit 1
	@set MAKEFLAGS=$(MAKEFLAGS)
	cd serialport\ && ( if not exist Makefile $(QMAKE) R:\development\libs\qt\qt.5.7.0.static.x32\qtserialport\src\serialport\serialport.pro -o Makefile ) && $(MAKE) -f Makefile release
release: sub-serialport-release

html_docs:
	$(MAKE) -f $(MAKEFILE) prepare_docs && $(MAKE) -f $(MAKEFILE) generate_docs

docs:
	$(MAKE) -f $(MAKEFILE) html_docs && $(MAKE) -f $(MAKEFILE) qch_docs

sub-serialport-install_html_docs:
	@if not exist serialport\ mkdir serialport\ & if not exist serialport\ exit 1
	@set MAKEFLAGS=$(MAKEFLAGS)
	cd serialport\ && ( if not exist Makefile $(QMAKE) R:\development\libs\qt\qt.5.7.0.static.x32\qtserialport\src\serialport\serialport.pro -o Makefile ) && $(MAKE) -f Makefile install_html_docs
install_html_docs: sub-serialport-install_html_docs

sub-serialport-uninstall_html_docs:
	@if not exist serialport\ mkdir serialport\ & if not exist serialport\ exit 1
	@set MAKEFLAGS=$(MAKEFLAGS)
	cd serialport\ && ( if not exist Makefile $(QMAKE) R:\development\libs\qt\qt.5.7.0.static.x32\qtserialport\src\serialport\serialport.pro -o Makefile ) && $(MAKE) -f Makefile uninstall_html_docs
